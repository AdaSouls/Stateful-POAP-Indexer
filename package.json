{
  "name": "@game/template-game",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx tsc --build tsconfig.build.json",
    "chain:start": "npx hardhat node",
    "chain:deploy": "npx hardhat run ./contracts/evm/hardhat/scripts/deployContracts.js --network ${NETWORK:-localhost}",
    "compile:api": "npm run compile -w api/",
    "compile:db": "npm run compile -w db/",
    "database:up": "cd db/docker && docker compose up",
    "database:down": "cd db/docker && docker compose down",
    "database:reset": "node change-db.js",
    "initialize": "npm ci && cp .env.example ../.env.localhost && cp extensions.yml ../extensions.yml",
    "initialize2": "cp .env.example ../.env.localhost && cp extensions.yml ../extensions.yml",
    "initialize-testnet": "cp .env.testnet ../.env.testnet && cp extensions.yml ../extensions.yml",
    "initialize-amoy": "cp .env.amoy ../.env.amoy && cp extensions.yml ../extensions.yml",
    "lint": "eslint --ext ts,tsx --ignore-path .gitignore .",
    "lint:fix": "eslint --ext ts,tsx --ignore-path .gitignore --fix .",
    "pack": "sh scripts/pack.sh",
    "pack:middleware": "npm run build -w middleware/",
    "prettier": "prettier --config .prettierrc --ignore-path .prettierignore --check .",
    "prettier:fix": "prettier --write --config .prettierrc --ignore-path .prettierignore --check .",
    "reset": "sh scripts/reset.sh",
    "test": "DOTENV_CONFIG_PATH=../.env.localhost jest",
    "test:watch": "npm test -- --watch",
    "wipe": "sh scripts/wipe.sh"
  },
  "workspaces": [
    "./utils",
    "./db",
    "./api",
    "./game-logic",
    "./state-transition",
    "./middleware"
  ],
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.1.0",
    "@paima/build-utils": "2.2.0",
    "@types/eslint": "^8.56.2",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "hardhat": "^2.22.19",
    "hardhat-abi-exporter": "github:paimaStudios/hardhat-abi-exporter#export-ts-wrapper",
    "hardhat-dependency-compiler": "^1.1.3",
    "hardhat-interact": "github:paimaStudios/hardhat-interact-bin#master",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@paima/evm-contracts": "^3.0.0",
    "@paima/node-sdk": "2.2.0",
    "@paima/sdk": "2.2.0"
  }
}
